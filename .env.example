TMDB_API_KEY=<your_tmdb_api_key>

# MongoDB shards are allocated in the order listed. Separate URIs with semicolons.
# A URI may contain commas for replica-set hosts, so do not use commas as separators.
MONGODB_URLS=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Optional dedicated control-plane cluster. Defaults to the first shard URL.
# MONGODB_CONTROL_URL=mongodb+srv://<user>:<password>@control.example.mongodb.net/?retryWrites=true&w=majority
# Optional stable IDs; provide the same number as MONGODB_URLS, separated by semicolons.
# MONGODB_SHARD_IDS=atlas-primary
MONGODB_DATABASE_NAME=watchly
MONGODB_CONTROL_DATABASE_NAME=watchly_control
# Atlas M0 default. Set to the capacity/quota you want Watchly to enforce per cluster.
MONGODB_MAX_STORAGE_BYTES=536870912
MONGODB_ALLOCATION_THRESHOLD=0.80
MONGODB_NEW_USER_RESERVE_BYTES=1048576

TOKEN_SALT=change-me # generate a long random secret before production

# app setup
APP_ENV=development
HOST_NAME=<your_addon_url>
PORT=8000
ALLOW_SIGNUPS=True

# Optional integrations
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=   # only for legacy (non-PKCE) Trakt apps
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
